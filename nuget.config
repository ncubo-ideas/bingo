<?xml version="1.0" encoding="utf-8"?>
<!-- Ncubo.Puppeteer, its Sockets adapter and its Iroh adapter come from
     App/BingoApp/localfeed for every project in the repo: those builds exist in no
     published feed (see App/BingoApp/nuget.config for why). Everything else comes
     from nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="bingo-localfeed" value="App\BingoApp\localfeed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="bingo-localfeed">
      <package pattern="Ncubo.Puppeteer" />
      <package pattern="Ncubo.Puppeteer.Adapters.Sockets" />
      <package pattern="Ncubo.Puppeteer.Adapters.Iroh" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
