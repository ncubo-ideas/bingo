<?xml version="1.0" encoding="utf-8"?>
<!-- The web player only needs nuget.org and the hand-built Ncubo.Puppeteer in
     App/BingoApp/localfeed (see App/BingoApp/nuget.config for why). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="bingo-localfeed" value="..\BingoApp\localfeed" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="bingo-localfeed">
      <package pattern="Ncubo.Puppeteer" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
