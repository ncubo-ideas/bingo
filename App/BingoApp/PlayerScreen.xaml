<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BingoApp"
             x:Class="BingoApp.PlayerScreen"
             Title="{local:Text jugador.titulo}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#2A0F3D">

    <!-- La pantalla del jugador es una pagina HTML servida desde Resources/Raw/wwwroot:
         la escena de feria del diseno se reproduce tal cual en el WebView, cosa que en
         XAML seria imposible (animaciones, capas, brillos). El dominio no se entera:
         LivePlayer sigue mandando, y este code-behind solo traduce su estado a JSON
         y las acciones de la pagina a los mismos manejadores de siempre. -->
    <HybridWebView x:Name="Web" RawMessageReceived="OnWebMessage" />

</ContentPage>
