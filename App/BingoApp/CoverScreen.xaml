<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BingoApp"
             x:Class="BingoApp.CoverScreen"
             BackgroundColor="{StaticResource Ground}"
             Shell.NavBarIsVisible="False">

    <!-- La portada. Solo la ve quien abre la app SIN enlace: al que escanea el QR se lo
         lleva OnAppearing derecho a lo suyo, asi que estas filas son para el organizador
         (que nunca tiene enlace) y para quien vuelve despues de cerrar la app.

         Arriba va justamente eso: volver. El telefono ya recordaba el papel, pero solo lo
         imprimia como etiqueta — informacion en el lugar donde cabia una accion. -->
    <ScrollView>
        <VerticalStackLayout Padding="24,56,24,32" Spacing="14">

            <Label Text="{local:Text portada.titulo}" Style="{StaticResource Title}"
                   HorizontalTextAlignment="Center" />
            <Label Text="{local:Text portada.como-quieres-entrar}" Style="{StaticResource Explainer}"
                   HorizontalTextAlignment="Center" Margin="0,0,0,10" />

            <!-- ── volver a lo tuyo ─────────────────────────────────────── -->
            <Border x:Name="ComeBackPanel" Style="{StaticResource Panel}"
                    BackgroundColor="{StaticResource OrganizerSoft}"
                    Stroke="{StaticResource Organizer}" IsVisible="False">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnComeBack" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="46,*,Auto" ColumnSpacing="14">
                    <Label Text="&#x21BA;" FontSize="24" VerticalOptions="Center"
                           HorizontalTextAlignment="Center"
                           TextColor="{StaticResource Organizer}" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label x:Name="ComeBackName" Style="{StaticResource RoleName}"
                               FontSize="18" />
                        <Label x:Name="ComeBackSays" Style="{StaticResource Explainer}"
                               FontSize="13.5" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="&#x203A;" FontSize="22"
                           VerticalOptions="Center" TextColor="{StaticResource Organizer}" />
                </Grid>
            </Border>

            <Label x:Name="OrElseLabel" Text="{local:Text portada.o-entra-con-otro-papel}"
                   Style="{StaticResource Rubric}" HorizontalTextAlignment="Center"
                   Margin="0,8,0,0" IsVisible="False" />

            <!-- ── los tres papeles, como filas ─────────────────────────── -->
            <Border Style="{StaticResource Panel}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnChooseCommunityLeader" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="46,*,Auto" ColumnSpacing="14">
                    <Border BackgroundColor="{StaticResource OrganizerSoft}" StrokeThickness="0"
                            HeightRequest="46" WidthRequest="46" VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Label Text="&#x1F4C5;" FontSize="20" VerticalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{local:Text papel.CommunityLeader}" Style="{StaticResource RoleName}" FontSize="18"
                               TextColor="{StaticResource Organizer}" />
                        <Label Text="{local:Text portada.organizador.que}" Style="{StaticResource Explainer}"
                               FontSize="14" />
                        <Label Text="{local:Text portada.organizador.detalle}"
                               Style="{StaticResource Explainer}" FontSize="13" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="&#x203A;" FontSize="22" VerticalOptions="Center"
                           TextColor="{StaticResource InkSoft}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Panel}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnChooseCollaborator" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="46,*,Auto" ColumnSpacing="14">
                    <Border BackgroundColor="{StaticResource SellerSoft}" StrokeThickness="0"
                            HeightRequest="46" WidthRequest="46" VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Label Text="&#x1F3F7;" FontSize="20" VerticalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{local:Text papel.Collaborator}" Style="{StaticResource RoleName}" FontSize="18"
                               TextColor="{StaticResource Seller}" />
                        <Label Text="{local:Text portada.colaborador.que}" Style="{StaticResource Explainer}"
                               FontSize="14" />
                        <Label Text="{local:Text portada.colaborador.detalle}"
                               Style="{StaticResource Explainer}" FontSize="13" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="&#x203A;" FontSize="22" VerticalOptions="Center"
                           TextColor="{StaticResource InkSoft}" />
                </Grid>
            </Border>

            <!-- Jugador se queda aunque la maqueta lo quite: a quien se le cerro la app a
                 media noche esta es su unica vuelta, y PlayerScreen sin codigo si rehidrata
                 sus cartones del diario. -->
            <Border Style="{StaticResource Panel}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnChoosePlayer" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="46,*,Auto" ColumnSpacing="14">
                    <Border BackgroundColor="{StaticResource PlayerSoft}" StrokeThickness="0"
                            HeightRequest="46" WidthRequest="46" VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Label Text="&#x1F3B1;" FontSize="20" VerticalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{local:Text papel.Player}" Style="{StaticResource RoleName}" FontSize="18"
                               TextColor="{StaticResource Player}" />
                        <Label Text="{local:Text portada.jugador.que}"
                               Style="{StaticResource Explainer}" FontSize="14" />
                        <Label Text="{local:Text portada.jugador.detalle}"
                               Style="{StaticResource Explainer}" FontSize="13" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="&#x203A;" FontSize="22" VerticalOptions="Center"
                           TextColor="{StaticResource InkSoft}" />
                </Grid>
            </Border>

            <Button x:Name="ForgetButton" Text="{local:Text portada.olvidar-mi-papel}"
                    Style="{StaticResource QuietButton}" Clicked="OnForget" IsVisible="False"
                    Margin="0,10,0,0" />

            <!-- ── el idioma ─────────────────────────────────────────────────
                 El dueno es el telefono (AppLanguage.cs): lo que se toca aca vale para las
                 paginas, los toasts y el registro de lo que va pasando. Cada idioma se
                 nombra en su propia lengua, por eso esos dos rotulos no cambian. -->
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,16,0,0">
                <Label x:Name="LanguageLabel" Text="{local:Text general.idioma}"
                       Style="{StaticResource Rubric}" VerticalOptions="Center" />
                <Button x:Name="SpanishButton" Grid.Column="1" Text="{local:Text general.espanol}"
                        Style="{StaticResource QuietButton}" FontSize="12" Clicked="OnSpanish" />
                <Button x:Name="EnglishButton" Grid.Column="2" Text="{local:Text general.ingles}"
                        Style="{StaticResource QuietButton}" FontSize="12" Clicked="OnEnglish" />
            </Grid>

            <Button Text="{local:Text portada.prueba-corrillo}"
                    Style="{StaticResource QuietButton}" FontSize="12"
                    Clicked="OnTryHuddle" Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
