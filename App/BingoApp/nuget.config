<?xml version="1.0" encoding="utf-8"?>
<!-- BingoApp only. Ncubo.Puppeteer, Ncubo.Puppeteer.Adapters.Sockets and
     Ncubo.Puppeteer.Adapters.Iroh come from localfeed/, not from a published feed:
     - Android has no ASP.NET runtime, so the Kestrel-based TransportType.Https cannot run on
       the phone. These builds bring TransportType.PortableHttps (TcpListener + SslStream,
       BCL only), which lives in Adapters.Sockets.
     - The published Adapters.Sockets declares Microsoft.AspNetCore.App as a frameworkReference
       that flows to the consumer and breaks the Android build with NETSDK1082. These builds
       mark it PrivateAssets="all".
     Puppeteer and Adapters.Sockets are a pair: always use both with the same version suffix.
     If a package is rebuilt with the same version, purge it from ~/.nuget/packages first.
     This file maps those packages to localfeed/ and leaves the rest as in the root
     nuget.config. -->
<configuration>
  <packageSources>
    <add key="bingo-localfeed" value="localfeed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="bingo-localfeed">
      <package pattern="Ncubo.Puppeteer" />
      <package pattern="Ncubo.Puppeteer.Adapters.Sockets" />
      <package pattern="Ncubo.Puppeteer.Adapters.Iroh" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
