<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BingoApp"
             x:Class="BingoApp.CallerScreen"
             Title="{local:Text cantar.titulo}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Paper}">

    <!-- La noche en marcha: la tombola, lo que va pasando en la mesa y los verbos de la
         ronda. Reemplaza a la pestaña CANTAR de la pantalla vieja.

         El reloj de un segundo se quedo: el organizador tiene que enterarse de un BINGO
         que ocurre en el telefono de otro, y eso no dispara Changed en este. -->
    <HybridWebView x:Name="Web" DefaultFile="caller.html"
                   RawMessageReceived="OnWebMessage" />

</ContentPage>
